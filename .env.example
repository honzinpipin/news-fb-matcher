# Zkopíruj tento soubor jako .env a doplň své klíče (bez uvozovek, bez mezer kolem =).
# Soubor .env se do gitu neposílá.

# Povinné: OpenAI API klíč (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Povinné pro stahování příspěvků z Facebooku: Bright Data API klíč
# (https://brightdata.com/cp/setting/users -> API key)
BRIGHTDATA_TOKEN=

# Nepovinné: token Telegram bota od @BotFather (doplní do reportu číselné ID kanálů)
TELEGRAM_BOT_TOKEN=
